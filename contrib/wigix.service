# systemd user unit. `wigix init --systemd` writes one with the right ExecStart for your install.
# By hand:
#   mkdir -p ~/.config/systemd/user && cp contrib/wigix.service ~/.config/systemd/user/
#   systemctl --user daemon-reload && systemctl --user enable --now wigix
# Adjust ExecStart to where you installed wigix (pipx: %h/.local/bin/wigix, venv: %h/path/.venv/bin/wigix).
[Unit]
Description=Wigix dashboard
After=network-online.target

[Service]
ExecStart=/usr/bin/wigix run -c %h/.config/wigix/dashboard.yaml
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
