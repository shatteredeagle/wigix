# systemd user unit. Install:
#   mkdir -p ~/.config/systemd/user && cp contrib/wigidash.service ~/.config/systemd/user/
#   systemctl --user daemon-reload && systemctl --user enable --now wigidash
# Adjust ExecStart to where you installed wigidash (pipx: %h/.local/bin/wigidash).
[Unit]
Description=WigiDash dashboard
After=network-online.target

[Service]
ExecStart=%h/code/wigidash/.venv/bin/wigidash run -c %h/.config/wigidash/dashboard.yaml
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
